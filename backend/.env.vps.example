# Knowtis backend VPS template. Copy to .env on the VPS and fill in secrets.

APP_ENV=production
DEBUG=False
PORT=8000

# Use your real domain after DNS/HTTPS is configured. For first boot, the IP URL works.
BACKEND_URL=http://204.12.245.227:8000
FRONTEND_URL=https://your-frontend-domain.com
CORS_ORIGINS=https://your-frontend-domain.com
OPENAPI_SERVERS=http://204.12.245.227:8000

# Persistent SQLite path mounted by docker-compose.vps.yml.
# For heavier production use, replace this with a managed/external PostgreSQL URL.
DATABASE_URL=sqlite:////app/data/knowtis.db

# Generate both with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET
REFRESH_TOKEN_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis is supplied by docker-compose.vps.yml.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Periodic jobs are run by the celery beat container on VPS to avoid duplicate schedulers.
SCHEDULER_ENABLED=False
SEMANTIC_PREWARM_ENABLED=False

# WhatsApp connector stays on its existing server unless you move it separately.
WHATSAPP_CONNECTOR_URL=https://knowtis-whatsapp.onrender.com
WHATSAPP_CONNECTOR_TIMEOUT=30.0
WHATSAPP_CONNECTOR_WEBHOOK_SECRET=
WHATSAPP_CONNECTOR_API_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
REVENUECAT_WEBHOOK_SECRET=
GROQ_API_KEY=

LOG_LEVEL=INFO
LOG_FORMAT=json
APP_TIMEZONE=Africa/Lagos
