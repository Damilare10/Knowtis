# Knowtis Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# For development: SQLite (default)
DATABASE_URL=sqlite:///./knowtis.db

# For production: PostgreSQL with pgvector
# DATABASE_URL=postgresql://user:password@localhost:5432/knowtis

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET
REFRESH_TOKEN_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000

# ── RevenueCat ────────────────────────────────────────────────────────────────
# Found in RevenueCat Dashboard → Project Settings → Webhooks
REVENUECAT_WEBHOOK_SECRET=

# ── AI & Embeddings ───────────────────────────────────────────────────────────
# Cosine similarity threshold for deduplication (0.0–1.0)
SIMILARITY_THRESHOLD=0.75

# ── WhatsApp Connector ────────────────────────────────────────────────────────
# Base URL of the external WhatsApp connector (Baileys/Puppeteer bridge).
WHATSAPP_CONNECTOR_URL=http://localhost:3001
WHATSAPP_CONNECTOR_TIMEOUT=30.0
# Shared secret expected in the ``X-Webhook-Secret`` header on
# /api/v1/whatsapp/webhook. When empty, the webhook is rejected fail-closed.
# MUST match the WEBHOOK_SECRET env var on the whatsapp_connector side.
WHATSAPP_CONNECTOR_WEBHOOK_SECRET=

# Same shared secret used by the backend to authenticate calls TO the
# whatsapp_connector (X-Connector-Secret / ?secret= on /status, /generate-qr,
# /disconnect, /reconnect, /join, /groups). Defaults to the webhook secret
# above when WHATSAPP_CONNECTOR_API_SECRET is unset; set explicitly to diverge.
WHATSAPP_CONNECTOR_API_SECRET=

# ── AI Catch-Up Agent (Groq LLM, premium tier) ───────────────────────────────
# Leave GROQ_API_KEY blank to disable the LLM and serve deterministic
# (free-tier) answers only. When set, premium users get conversational
# answers grounded on the deterministic retrieval context.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_FREE_MODEL=llama-3.1-8b-instant
AI_PREMIUM_MODEL=llama-3.3-70b-versatile
AI_REQUEST_TIMEOUT=60
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1024
# Tiered AI quotas (per user, per day)
AI_FREE_DAILY_LIMIT=20
AI_PREMIUM_DAILY_LIMIT=200

# ── Premium Real-Time Alerts (Push Channel) ────────────────────────────────────
# Webhook URL that receives premium push/DM alerts as a JSON POST.
# Leave empty (and PUSH_WEBHOOK_ENABLED=false) to disable webhook push delivery.
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_ENABLED=false
PUSH_WEBHOOK_TIMEOUT_SECONDS=5.0
# Minimum shift (minutes) for a scheduled-time change to trigger an urgent
# timeline-shift push alert.
TIMELINE_SHIFT_THRESHOLD_MINUTES=5.0

# ── Application URLs ──────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_OCR_FREE=10/hour
RATE_LIMIT_OCR_PREMIUM=50/hour

# ── Celery & Redis (Workers) ──────────────────────────────────────────────────
# Redis is the Celery broker AND result backend. Start Redis locally or use a
# managed instance, then point all three at the same URL.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Production default is False so tasks run on a real Celery worker.
# Set to True ONLY for local dev/tests without a worker (tests force True via conftest).
CELERY_TASK_ALWAYS_EAGER=False

# ── Worker Burst Protection ───────────────────────────────────────────────────
# Randomized jitter (seconds) injected before each task body to smooth out bursts.
# Skipped automatically when CELERY_TASK_ALWAYS_EAGER=True (tests/local).
WORKER_JITTER_MIN_SECONDS=0.5
WORKER_JITTER_MAX_SECONDS=2.0

# ── WhatsApp Anti-Ban Session Rotation ────────────────────────────────────────
# How long a worker session stays active before rotating, and the desired size
# of the rotating worker session pool used for staggered group joins.
WHATSAPP_SESSION_ROTATION_INTERVAL_MINUTES=120
WHATSAPP_WORKER_POOL_SIZE=3

# ── Logging & Observability ───────────────────────────────────────────────────
# DEBUG=True returns tracebacks inside 500 responses during development.
# Leave False in production so internal error details are never leaked to clients.
DEBUG=False
# Root log level for the application (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
# Log renderer: "json" for structured production logs, "console" for pretty dev output.
LOG_FORMAT=json
# Comma-separated list of server URLs surfaced in the OpenAPI spec.
# Leave empty to derive a single entry from BACKEND_URL.
OPENAPI_SERVERS=
