# WhatsApp Connector Configuration
PORT=3001
FASTAPI_WEBHOOK_URL=http://localhost:8000/api/v1/whatsapp/webhook

# Shared secret sent in the X-Webhook-Secret header on outbound webhooks to the
# FastAPI backend. MUST match WHATSAPP_CONNECTOR_WEBHOOK_SECRET on the backend.
WEBHOOK_SECRET=

# Shared secret required to call the connector's own endpoints (X-Connector-Secret
# header, or ?secret= query on the /status browser page). Falls back to
# WEBHOOK_SECRET when unset. MUST match WHATSAPP_CONNECTOR_API_SECRET (or, if
# that's unset, WHATSAPP_CONNECTOR_WEBHOOK_SECRET) on the backend.
CONNECTOR_API_SECRET=
